# ==============================================================================
# CRM Escolar — Variáveis de Ambiente (Vercel & Supabase)
# ==============================================================================
# Obtenha essas credenciais no painel do Supabase:
# 1. Acesse: https://supabase.com/dashboard/project/_/settings/api
# 2. Em "Project URL", copie o endereço -> SUPABASE_URL
# 3. Em "Project API Keys", copie a chave "anon" "public" -> SUPABASE_ANON_KEY
#
# ⚠️ IMPORTANTE — SEGURANÇA:
# - Use APENAS a chave "anon" (pública).
# - NUNCA utilize ou exponha a chave "service_role" (privada) no frontend.
# ==============================================================================

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
